                 7.382614\n","cinza_volante          5.509063\n","superplastificante     1.547269\n","agregado_miudo         1.376013\n","agregado_graudo        1.194763\n","relacao_ac            -1.368445\n","agua                  -3.039984\n"]}],"source":["!pip install -q ucimlrepo\n","\n","import numpy as np\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","from ucimlrepo import fetch_ucirepo\n","from sklearn.model_selection import train_test_split\n","from sklearn.preprocessing import StandardScaler, PolynomialFeatures\n","from sklearn.pipeline import Pipeline\n","from sklearn.linear_model import LinearRegression, LogisticRegression\n","from sklearn.neighbors import KNeighborsClassifier\n","from sklearn.dummy import DummyClassifier\n","from sklearn.metrics import (\n","    mean_absolute_error, mean_squared_error, r2_score,\n","    accuracy_score, precision_score, recall_score, f1_score,\n","    confusion_matrix\n",")\n","\n","try:\n","    concrete = fetch_ucirepo(id=165)\n","    df = pd.concat([concrete.data.features, concrete.data.targets], axis=1)\n","except Exception:\n","    url = \"https://archive.ics.uci.edu/ml/machine-learning-databases/concrete/compressive/Concrete_Data.xls\"\n","    df = pd.read_excel(url)\n","\n","df.columns = [\n","    'cimento', 'escoria', 'cinza_volante', 'agua',\n","    'superplastificante', 'agregado_graudo', 'agregado_miudo',\n","    'idade', 'resistencia'\n","]\n","\n","df = df.drop_duplicates().reset_index(drop=True)\n","\n","assert df.isna().sum().sum() == 0\n","assert (df >= 0).all().all()\n","\n","df['relacao_ac'] = df['agua'] / df['cimento']\n","\n","def categorizar_risco(mpa):\n","    if mpa < 25.0:\n","        return 'Risco Técnico'\n","    elif mpa < 35.0:\n","        return 'Atenção'\n","    else:\n","        return 'Baixo Risco'\n","\n","df['classe_risco'] = df['resistencia'].apply(categorizar_risco)\n","\n","features = [\n","    'cimento', 'escoria', 'cinza_volante', 'agua',\n","    'superplastificante', 'agregado_graudo', 'agregado_miudo',\n","    'idade', 'relacao_ac'\n","]\n","\n","X = df[features]\n","y_reg = df['resistencia']\n","y_clf = df['classe_risco']\n","\n","X_train, X_test, y_reg_train, y_reg_test, y_clf_train, y_clf_test = train_test_split(\n","    X, y_reg, y_clf, test_size=0.20, random_state=42, stratify=y_clf\n",")\n","\n","df_train = X_train.copy()\n","df_train['resistencia'] = y_reg_train\n","df_train['classe_risco'] = y_clf_train\n","\n","regressores = {\n","    'Linear Simples (Cimento)': Pipeline([\n","        ('scaler', StandardScaler()),\n","        ('model', LinearRegression())\n","    ]),\n","    'Linear Múltipla': Pipeline([\n","        ('scaler', StandardScaler()),\n","        ('model', LinearRegression())\n","    ]),\n","    'Polinomial (Grau 2)': Pipeline([\n","        ('poly', PolynomialFeatures(degree=2, include_bias=False)),\n","        ('scaler', StandardScaler()),\n","        ('model', LinearRegression())\n","    ])\n","}\n","\n","resultados_reg = []\n","preds_reg = {}\n","\n","y_pred_base_reg = np.full_like(y_reg_test, fill_value=y_reg_train.mean())\n","resultados_reg.append({\n","    'Modelo': 'Baseline (Média)',\n","    'MAE (MPa)': mean_absolute_error(y_reg_test, y_pred_base_reg),\n","    'RMSE (MPa)': np.sqrt(mean_squared_error(y_reg_test, y_pred_base_reg)),\n","    'R²': r2_score(y_reg_test, y_pred_base_reg),\n","    'R² Ajustado': 0.0\n","})\n","\n","n_test = len(y_reg_test)\n","\n","for nome, pipe in regressores.items():\n","    if nome == 'Linear Simples (Cimento)':\n","        pipe.fit(X_train[['cimento']], y_reg_train)\n","        y_pred = pipe.predict(X_test[['cimento']])\n","        p = 1\n","    else:\n","        pipe.fit(X_train, y_reg_train)\n","        y_pred = pipe.predict(X_test)\n","        p = pipe.named_steps['poly'].n_output_features_ if 'poly' in pipe.named_steps else X_train.shape[1]\n","\n","    preds_reg[nome] = y_pred\n","    mae = mean_absolute_error(y_reg_test, y_pred)\n","    rmse = np.sqrt(mean_squared_error(y_reg_test, y_pred))\n","    r2 = r2_score(y_reg_test, y_pred)\n","    r2_adj = 1 - (1 - r2) * (n_test - 1) / (n_test - p - 1)\n","\n","    resultados_reg.append({\n","        'Modelo': nome,\n","        'MAE (MPa)': mae,\n","        'RMSE (MPa)': rmse,\n","        'R²': r2,\n","        'R² Ajustado': r2_adj\n","    })\n","\n","df_resultados_reg = pd.DataFrame(resultados_reg)\n","print(\"=== TAREFA 1: MODELOS DE REGRESSÃO CONTÍNUA (MPa) ===\")\n","print(df_resultados_reg.to_string(index=False))\n","\n","classificadores = {\n","    'Referência (Dummy - Moda)': DummyClassifier(strategy=\"most_frequent\"),\n","    'Modelo A: Regressão Logística': Pipeline([\n","        ('scaler', StandardScaler()),\n","        ('model', LogisticRegression(C=1.0, max_iter=1000, random_state=42))\n","    ]),\n","    'Modelo B: KNN (k=5, Manhattan)': Pipeline([\n","        ('scaler', StandardScaler()),\n","        ('model', KNeighborsClassifier(n_neighbors=5, metric='manhattan', weights='distance'))\n","    ])\n","}\n","\n","resultados_clf = []\n","preds_clf = {}\n","ordem_classes = ['Risco Técnico', 'Atenção', 'Baixo Risco']\n","\n","for nome, model in classificadores.items():\n","    model.fit(X_train, y_clf_train)\n","    y_pred = model.predict(X_test)\n","    preds_clf[nome] = y_pred\n","\n","    acc = accuracy_score(y_clf_test, y_pred)\n","    prec = precision_score(y_clf_test, y_pred, zero_division=0, average='weighted')\n","    rec = recall_score(y_clf_test, y_pred, average='weighted')\n","    f1 = f1_score(y_clf_test, y_pred, average='weighted')\n","\n","    cm_temp = confusion_matrix(y_clf_test, y_pred, labels=ordem_classes)\n","    rec_risco = cm_temp[0, 0] / cm_temp[0, :].sum() if cm_temp[0, :].sum() > 0 else 0.0\n","\n","    resultados_clf.append({\n","        'Modelo': nome,\n","        'Acurácia': acc,\n","        'Precisão (Weighted)': prec,\n","        'Recall (Weighted)': rec,\n","        'F1-Score (Weighted)': f1,\n","        'Recall (Risco Técnico)': rec_risco\n","    })\n","\n","df_resultados_clf = pd.DataFrame(resultados_clf)\n","print(\"\\n=== TAREFA 2: MODELOS DE CLASSIFICAÇÃO DE RISCO ===\")\n","print(df_resultados_clf.to_string(index=False))\n","\n","sns.set_theme(style=\"whitegrid\")\n","fig, axes = plt.subplots(2, 2, figsize=(15, 11))\n","\n","sns.heatmap(\n","    df_train.drop(columns=['classe_risco']).corr(),\n","    annot=True, cmap='coolwarm', fmt=\".2f\", ax=axes[0, 0]\n",")\n","axes[0, 0].set_title(\"EDA (Treino): Matriz de Correlação de Pearson\")\n","\n","sns.scatterplot(\n","    data=df_train, x='idade', y='resistencia',\n","    hue='classe_risco', palette='viridis', alpha=0.7, ax=axes[0, 1]\n",")\n","axes[0, 1].set_title(\"EDA (Treino): Resistência vs. Idade de Cura\")\n","axes[0, 1].set_xlabel(\"Idade (dias)\")\n","axes[0, 1].set_ylabel(\"Resistência (MPa)\")\n","\n","pred_poly = preds_reg['Polinomial (Grau 2)']\n","residuos_poly = y_reg_test - pred_poly\n","\n","axes[1, 0].scatter(pred_poly, residuos_poly, alpha=0.6, color='steelblue')\n","axes[1, 0].axhline(0, color='red', linestyle='--', lw=2)\n","axes[1, 0].set_title(\"Diagnóstico de Resíduos: Regressão Polinomial (Grau 2)\")\n","axes[1, 0].set_xlabel(\"Valores Previstos (MPa)\")\n","axes[1, 0].set_ylabel(\"Resíduos (e = Real - Previsto)\")\n","\n","cm_knn = confusion_matrix(y_clf_test, preds_clf['Modelo B: KNN (k=5, Manhattan)'], labels=ordem_classes)\n","sns.heatmap(\n","    cm_knn, annot=True, fmt='d', cmap='Blues',\n","    xticklabels=ordem_classes, yticklabels=ordem_classes, ax=axes[1, 1]\n",")\n","axes[1, 1].set_title(\"Matriz de Confusão: Modelo B (KNN)\")\n","axes[1, 1].set_xlabel(\"Predição do Modelo\")\n","axes[1, 1].set_ylabel(\"Valor Real\")\n","\n","plt.tight_layout()\n","plt.show()\n","\n","modelo_mult = regressores['Linear Múltipla'].named_steps['model']\n","coefs = pd.Series(modelo_mult.coef_, index=features).sort_values(ascending=False)\n","print(\"\\n--- COEFICIENTES DA REGRESSÃO LINEAR MÚLTIPLA ---\")\n","print(f\"Intercepto (w0): {modelo_mult.intercept_:.4f}\")\n","print(coefs.to_string())"]}]}